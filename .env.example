# copy it to .env only when you need different ports or names.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=product_catalog
API_PORT=8000
FRONTEND_PORT=3000

APP_NAME=Product Catalog API
APP_DESCRIPTION=REST API for the Product Catalog
APP_VERSION=1.0.0

# These values are used in API responses, CORS, and the frontend browser bundle.
API_BASE_URL=http://localhost:8000
LOCAL_WEB_APP_URL=http://localhost:3000
LIVE_WEB_APP_URL=
NEXT_PUBLIC_API_URL=http://localhost:8000
